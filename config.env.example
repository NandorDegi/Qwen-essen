# Pilot kit configuration. Copy to config.env (git ignores it) and check every value.
# The phases source this file with bash. Secrets never go here: the model API key is made by
# phase 30 in ~/.config/pilot/api_key (mode 600).

# Where the kit keeps its state and logs on the Spark
PILOT_HOME="$HOME/.config/pilot"
PILOT_LOGS="$HOME/pilot-logs"

# Model (phase 10): the Hugging Face repository and the exact revision (a commit hash)
MODEL_REPO="<owner>/<Qwen3.8-Flash-Next FP4-Local repository>"
MODEL_REVISION="<commit hash>"
MODEL_DIR="$HOME/models/Qwen3.8-Flash-Next-FP4-Local"

# Model server (phases 20, 30): a vLLM image with the b12x kernels for GB10, pinned by digest
VLLM_IMAGE="<registry/image:tag@sha256:digest>"
CONTAINER=pilot-llm
LLM_BIND="${LLM_BIND:-127.0.0.1}"   # 0.0.0.0 to let the operator's PC use the model too (the API key still applies)
LLM_PORT=8000
LLM_AUTH=key                         # key | none
SERVED_NAME=Qwen3.8-Flash-Next-FP4-Local
MAX_MODEL_LEN=262144
MAX_SEQS=8
KV_BYTES=7G                          # fixed K/V pool; lower (5G) if memguard fires
GPU_MEM=0.72
MTP_TOKENS=3
GUARD_GIB=4                          # memguard floor; 0 turns memguard off

# Toolchains (phase 40), all in user space
NODE_VERSION=v26.13.0                # dsh (phase 55) needs >= v24.9
GO_VERSION=go1.27.3
GOPLS_VERSION=v0.24.0
RUST_TOOLCHAIN=stable
OPENCODE_VERSION=1.19.5
TYPESCRIPT_VERSION=7.0.2
TSLS_VERSION=6.0.2
PYRIGHT_VERSION=1.1.414
PLAYWRIGHT_MCP_VERSION=0.0.83
PLAYWRIGHT_HEADED=0                  # 1: the browser opens on the Spark's screen

# opencode (phase 50)
OPENCODE_MAX_OUTPUT=65536            # reply cap; the prompt keeps MAX_MODEL_LEN minus this

# Web search (phase 45): SearXNG and its MCP server, on 127.0.0.1 only
SEARCH_ENABLED=1
SEARCH_PORT=8888
SEARCH_MCP_PORT=8889
SEARXNG_IMAGE=searxng/searxng:2026.11.6-ac11e14c5@sha256:c750ee1d859b26d3aeae51c07f6a48c3a0bfbaa9195d71a18b258862d88c4c3c
MCP_SEARXNG_IMAGE=isokoliuk/mcp-searxng:2.10.0@sha256:36984f151e3b575b17063eb222ce430dbb8b4bcf3f0abf0e86df18f20731d19b

# dsh, the optional second harness (phase 55)
DSH_VERSION=0.2.2-rc.1
DSH_WEB_HOST=127.0.0.1
DSH_WEB_PORT=3080
DSH_SYSTEMD=1                        # 0: no systemd --user unit, start `dsh web` by hand

# Optional knowledge base (phase 50): the Obsidian MCP server on the operator's PC
OBSIDIAN_MCP_URL=
OBSIDIAN_MCP_TOKEN_FILE="$HOME/.config/pilot/obsidian_token"
